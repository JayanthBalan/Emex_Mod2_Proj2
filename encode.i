Status copy_remaining_img_data(FILE *fptr_src, FILE *fptr_dest) {
    char buffer[16];
    size_t bytes_read;
    while((bytes_read = fread(&buffer, 1, 16, fptr_src)) > 0) {
        if(fwrite(&buffer, 1, bytes_read, fptr_dest) != bytes_read) {
            return e_failure;
        }
    }
    return e_success;
}

