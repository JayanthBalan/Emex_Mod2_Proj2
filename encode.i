                                     );
    char header[54];

    size_t bytes_transferred = fread(header, 1, 54, fptr_src_image);
    if(bytes_transferred != 54) {
        return e_failure;
    }

    bytes_transferred = fwrite(header, 1, 54, fptr_dest_image);
    if(bytes_transferred != 54) {
        return e_failure;
    }

    return e_success;
}

Status check_capacity(EncodeInfo *encInfo) {
    encInfo->image_capacity = get_image_size_for_bmp(encInfo->fptr_src_image);
    encInfo->size_secret_file = get_file_size(encInfo->fptr_secret);

    if(encInfo->image_capacity < ((encInfo->size_secret_file + e_magic_string_field +
        e_file_extn_size_field + e_file_size_field + encInfo->size_secret_file_extn)*(1 * 8))) {
        return e_failure;
    }
    return e_success;
}

